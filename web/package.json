{
  "name": "noteagent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:i18n && npm run check:terms && npm run check:hooks && tsc -b && vite build",
    "typecheck": "tsc -b --pretty",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:hooks": "oxlint --react-plugin -A all -D rules-of-hooks",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:terms": "node scripts/check-terms.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "i18next": "^26.4.2",
    "katex": "^0.16.47",
    "lucide-react": "^1.7.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.14",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
